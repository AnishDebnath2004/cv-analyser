# --------------------------------------------------------------
# Supabase User Authentication & Session Database
# --------------------------------------------------------------
# Get your URL and Anon Key from your Supabase Dashboard:
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# (Alternatively SUPABASE_ANON_KEY is also supported)
# SUPABASE_ANON_KEY=your-anon-key-here

# --------------------------------------------------------------
# Google Gemini AI Agent (Optional - powers executive synthesis & career chat)
# --------------------------------------------------------------
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# --------------------------------------------------------------
# O*NET Web Services API (Optional - official occupational data)
# --------------------------------------------------------------
# Get credentials from: https://services.onetcenter.org/
ONET_API_VERSION=v2
ONET_API_KEY=
# If using v1.9 Basic Auth:
ONET_USERNAME=
ONET_PASSWORD=
