{
  "version": 2,
  "buildCommand": "cd frontend && npm install --legacy-peer-deps && npm run build || true",
  "outputDirectory": "static",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|icons\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
