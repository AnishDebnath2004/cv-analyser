{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "outputDirectory": "static",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|icons\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
